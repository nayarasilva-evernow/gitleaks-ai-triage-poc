# Token com permissão SOMENTE LEITURA (repo contents: read, metadata: read).
# Nunca use um token com permissão de escrita.
GITHUB_TOKEN=ghp_xxxxxxxx

# Para GitHub Enterprise Server, ex: https://github.empresa.com/api/v3
# Deixe vazio para github.com
GITHUB_API_URL=

# Organização a varrer (obrigatório)
GITHUB_ORG=nome-da-org
